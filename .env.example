# PayPal Sandbox only. Never commit real credentials.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Stable deployment secrets. Use high-entropy values; never commit real values.
DURIN_AUTHORIZATION_KEY=
DURIN_PROVIDER_EVIDENCE_KEY=
DURIN_SOURCE_ATTESTATION_KEY=
# Required for multi-process PayPal execution; use a shared SQLite path.
DURIN_AUTHORIZATION_LEDGER_PATH=
# OpenAI structured extraction for AI_EXTRACTION.md / scripts/run_ai_extraction_pipeline.py.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
# Durable draft/review ledger for AI extraction candidates (see draft_ledger.py).
DURIN_DRAFT_LEDGER_PATH=
DURIN_SOURCE_DIR=
DURIN_OPERATIONS_PATH=
# Merchant payment policy for api_server.py: inline JSON, or a path to a JSON file
# (relative to the repo root). The demo policy ships in examples/level1/policy.json.
DURIN_POLICY_JSON=
DURIN_POLICY_PATH=examples/level1/policy.json
# Optional authorized mailbox connector (read-only, IMAPS only).
DURIN_IMAP_HOST=
DURIN_IMAP_USERNAME=
DURIN_IMAP_PASSWORD=
DURIN_IMAP_PORT=993
DURIN_IMAP_MAILBOX=INBOX
